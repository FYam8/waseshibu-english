{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waseshibu-writing-grader",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-16",
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ratelimits": [
    {
      "name": "STORY_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ]
}
